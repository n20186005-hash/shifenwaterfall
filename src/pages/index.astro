---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import HistorySection from '../components/HistorySection.astro';
import StoriesSection from '../components/StoriesSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';

const pageTitle = '十分瀑布｜新北市平溪區交通、開放時間、門票與旅遊指南';
const pageDescription = '十分瀑布完整繁體中文旅遊指南：歷史背景與傳說、開放與免費入園資訊、十分車站與公車交通、停車、友善步道、實用設施（廁所、餐飲、住宿、補給）、觀瀑重點、周邊景點、天氣、Google 地圖與常見問答。';

const pageUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const entityId = Astro.site ? new URL('/#shifen-waterfall', Astro.site).href : '#shifen-waterfall';
const heroImageUrl = Astro.site ? new URL('/images/shifen-waterfall-hero.jpg', Astro.site).href : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': entityId,
  name: '十分瀑布',
  alternateName: ['Shifen Waterfall', '十分瀑布公園', '彩虹淵', '平溪區 十分瀑布', '新北市 十分瀑布'],
  description: '位於新北市平溪區、基隆河上的垂簾型瀑布，以寬闊水幕、水霧與晴日彩虹景觀聞名。',
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(heroImageUrl ? { image: [heroImageUrl] } : {}),
  telephone: '+886-2-2495-8409',
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '乾坑10號',
    addressLocality: '平溪區',
    addressRegion: '新北市',
    postalCode: '226',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 25.0482681,
    longitude: 121.7846723,
  },
  hasMap: 'https://maps.app.goo.gl/tf7NwV2xuaYJ4ZiQ8',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
      opens: '09:00',
      closes: '18:00',
      description: '夏季時段（官方景點頁列示 6月至9月；年度延長安排仍以新北市政府觀光旅遊局公告為準）',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
      opens: '09:00',
      closes: '17:00',
      description: '非夏季時段（官方景點頁列示 10月至5月；如遇年度延長、維修或天候調整，以官方公告為準）',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    ratingCount: 29127,
    bestRating: '5',
    worstRating: '1',
  },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '遊客中心', value: true },
    { '@type': 'LocationFeatureSpecification', name: '公廁', value: true },
    { '@type': 'LocationFeatureSpecification', name: '停車場', value: true },
    { '@type': 'LocationFeatureSpecification', name: '友善／無障礙步道', value: true },
  ],
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Google 地圖導航地址', value: '226 新北市平溪區南山里南山坪136號' },
    { '@type': 'PropertyValue', name: 'Plus Code', value: '2QXP+HX' },
  ],
  sameAs: [
    'https://newtaipei.travel/zh-tw/Attractions/Detail/109612',
    'https://www.taiwan.net.tw/m1.aspx?id=2188&sNo=0001091',
    'https://maps.app.goo.gl/tf7NwV2xuaYJ4ZiQ8',
  ],
};

const faqs = [
  { q: '十分瀑布需要門票嗎？', a: '依新北市官方景點資訊，十分瀑布公園免費入園。若周邊停車或其他個別服務產生費用，則依現場公告為準。' },
  { q: '十分瀑布開放到幾點？', a: '官方景點頁採季節性時段：夏季列示 09:00–18:00，非夏季列示 09:00–17:00，最後入園通常為閉園前 30 分鐘。部分年度會另有春夏延長公告，出發前請查看新北旅客最新通知。' },
  { q: '從十分車站走到十分瀑布要多久？', a: '由十分車站與老街一帶步行前往，通常可抓約 20 分鐘以上；若從十分遊客中心進入友善步道，官方資料指出步道約 400 公尺、步行約 15 分鐘可到園區入口。實際時間依人流與步速而異。' },
  { q: '輪椅或嬰兒車可以前往嗎？', a: '可以優先使用十分友善步道。新北市已建置平緩坡道並持續串接無障礙通行動線；山區環境仍可能受天候、施工或現場管制影響，建議出發前向十分遊客中心確認。' },
  { q: '開車去十分瀑布方便停車嗎？', a: '官方景點資訊列有停車場設施，十分遊客中心周邊亦有導引。假日山區道路與停車需求較大，建議提早抵達或改搭臺鐵平溪線、公車等大眾運輸。' },
  { q: '十分瀑布和十分老街適合排在同一天嗎？', a: '很適合。兩者距離近，可把十分車站、十分老街、靜安吊橋與十分瀑布串成半日行程；若再延伸到平溪、望古或菁桐，可安排較完整的平溪線一日遊。' },
  { q: '十分瀑布附近有廁所、停車或補給嗎？', a: '十分遊客中心與園區內設有公共衛生間，遊客中心周邊有停車場，十分車站與老街一帶有雜貨、便利商店等小型補給點。詳細的類型中立清單請見本站「實用設施」段落；實際營業狀態以現場公告為準。' },
  { q: '雨天或颱風天適合去十分瀑布嗎？', a: '雨後水量往往更充沛、水幕更壯觀，但步道濕滑、溪水風險也會上升；豪雨、颱風或雷擊風險期間，官方可能實施入園管制。出發前請查看新北旅客最新公告，並以現場管制為準。' },
  { q: '平溪或十分有加油站、充電站嗎？', a: '平溪區內加油站與電動車充電點有限，自駕旅客建議在進入山區前，於瑞芳或 106 縣道沿線等外圍地區完成加油與充電規劃，避免山區補給不便。' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '十分瀑布（Shifen Waterfall）', ...(pageUrl ? { item: pageUrl } : {}) },
    { '@type': 'ListItem', position: 2, name: '平溪區' },
    { '@type': 'ListItem', position: 3, name: '新北市' },
    { '@type': 'ListItem', position: 4, name: '臺灣' },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <section class="relative min-h-[78svh] overflow-hidden bg-[#071d1a] text-white">
    <img src="/images/shifen-waterfall-hero.jpg" alt="十分瀑布寬闊水幕與平溪山林" width="1800" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-72" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,29,26,.94)_0%,rgba(7,29,26,.64)_44%,rgba(7,29,26,.18)_72%,rgba(7,29,26,.48)_100%)]"></div>
    <div class="absolute inset-0 opacity-30" style="background:repeating-linear-gradient(90deg,transparent 0 34px,rgba(255,255,255,.09) 35px 36px);"></div>
    <div class="container relative z-10 flex min-h-[78svh] items-end py-16 sm:py-20 lg:items-center">
      <div class="max-w-3xl">
        <nav aria-label="地理路徑" class="mb-4">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-white/60">
            <li class="font-semibold text-white/85">十分瀑布（Shifen Waterfall）</li>
            <li aria-hidden="true">›</li>
            <li>平溪區</li>
            <li aria-hidden="true">›</li>
            <li>新北市</li>
            <li aria-hidden="true">›</li>
            <li>臺灣</li>
          </ol>
        </nav>
        <div class="mb-5 flex flex-wrap gap-2">
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-sm backdrop-blur">新北市 · 平溪區</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-sm backdrop-blur">基隆河 · 垂簾型瀑布</span>
        </div>
        <p class="mb-3 text-sm font-bold tracking-[.24em] text-[#bce8dc]">十分瀑布 · 平溪山城水景</p>
        <h1 class="font-serif text-5xl font-bold leading-[1.08] tracking-tight sm:text-6xl lg:text-8xl">十分瀑布<br /><span class="text-[#c7f0e5]">山城裡的一道白色水幕</span></h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/82 sm:text-lg">十分瀑布（Shifen Waterfall）是官方園區名稱「十分瀑布公園」最常被使用的稱呼，位於臺灣新北市平溪區、基隆河上游。走進平溪山谷，沿基隆河聽見水聲逐漸放大。這座寬闊的垂簾式水幕以水霧與晴日可能出現的彩虹著稱，也因此有「彩虹淵」與「臺灣尼加拉瀑布」的別稱。</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#visit" class="btn bg-white text-[#0d2b26] hover:-translate-y-0.5">規劃參觀</a>
          <a href="https://maps.app.goo.gl/tf7NwV2xuaYJ4ZiQ8" target="_blank" rel="noopener external" class="btn border border-white/30 bg-white/10 text-white backdrop-blur hover:bg-white/18">開啟 Google 地圖</a>
        </div>
      </div>
    </div>
    <p class="absolute bottom-4 right-4 z-10 rounded-full bg-black/35 px-3 py-1 text-[11px] text-white/80 backdrop-blur">照片：Zairon · CC BY-SA 4.0</p>
  </section>

  <section class="border-b border-[#dbeae5] bg-white">
    <div class="container grid gap-px bg-[#dbeae5] sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-white px-6 py-7"><p class="text-xs font-bold tracking-widest text-[#668078]">GOOGLE 地圖評分快照</p><p class="mt-2 text-3xl font-bold text-[#0d2b26]">4.5 <span class="text-base font-medium text-[#668078]">/ 5</span></p><p class="text-sm text-[#6d827c]">29,127 則評分（依使用者提供資料）</p></div>
      <div class="bg-white px-6 py-7"><p class="text-xs font-bold tracking-widest text-[#668078]">門票</p><p class="mt-2 text-3xl font-bold text-[#0d2b26]">免費</p><p class="text-sm text-[#6d827c]">依新北市官方景點資訊</p></div>
      <div class="bg-white px-6 py-7"><p class="text-xs font-bold tracking-widest text-[#668078]">友善步道</p><p class="mt-2 text-3xl font-bold text-[#0d2b26]">約 400 m</p><p class="text-sm text-[#6d827c]">官方資料：約 15 分鐘至園區入口</p></div>
      <div class="bg-white px-6 py-7"><p class="text-xs font-bold tracking-widest text-[#668078]">建議停留</p><p class="mt-2 text-3xl font-bold text-[#0d2b26]">1.5–2.5 小時</p><p class="text-sm text-[#6d827c]">瀑布＋步道的舒適節奏</p></div>
    </div>
  </section>

  <section id="about" class="section mist-bg overflow-hidden">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-[.92fr_1.08fr] lg:items-center">
        <div>
          <p class="section-kicker">瀑布特色</p>
          <h2 class="section-title">不是只有「大」，而是河流與岩層共同塑造的水幕</h2>
          <p class="section-copy">十分瀑布位在基隆河上。官方旅遊資料指出，這一帶受河流侵蝕、斷層與切割地形影響，形成一連串瀑布景觀。十分瀑布屬垂簾型／幕簾式瀑布，水氣在陽光下有機會形成彩虹，因此也有「彩虹淵」之名。</p>
          <div class="mt-7 flex flex-wrap gap-2">
            <span class="tag">基隆河水系</span><span class="tag">幕簾式瀑布</span><span class="tag">多角度觀景台</span><span class="tag">山城鐵道旅行</span>
          </div>
          <div class="mt-8 rounded-3xl border border-[#cfe2dc] bg-white/72 p-6">
            <p class="font-bold text-[#0d2b26]">地名與地址為什麼看起來不一樣？</p>
            <p class="mt-2 text-sm leading-7 text-[#526a63]">新北旅客的「十分瀑布公園」官方地址列為<strong>新北市平溪區乾坑10號</strong>；Google 地圖與十分遊客中心常用導航地址為<strong>新北市平溪區南山里南山坪136號</strong>。兩者都與實際遊覽動線相關，本指南同時保留，避免導航與官方資料互相混淆。</p>
          </div>
        </div>
        <figure class="relative">
          <img src="/images/shifen-waterfall-rainbow.jpg" alt="十分瀑布水霧上方出現彩虹" width="1600" height="1067" loading="lazy" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-[0_30px_80px_rgba(7,29,26,.18)]" />
          <figcaption class="mt-3 text-xs text-[#71867f]">十分瀑布與彩虹。照片：miyaiijima，CC BY 2.0。</figcaption>
          <div class="absolute -bottom-5 -left-5 hidden rounded-3xl bg-[#0d2b26] p-5 text-white shadow-xl sm:block">
            <p class="text-xs tracking-widest text-white/58">觀景提示</p><p class="mt-1 font-serif text-xl">彩虹取決於陽光、水霧與觀看角度，不保證每次都能遇見。</p>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <HistorySection />
  <StoriesSection />

  <section id="visit" class="section bg-[#0d2b26] text-white">
    <div class="container">
      <p class="section-kicker !text-[#8ed1bf]">參觀資訊</p>
      <h2 class="section-title">開放時間、門票與最佳遊覽節奏</h2>
      <p class="max-w-3xl text-white/68">山區景點的實際開放狀態可能受季節、豪雨、颱風、維修與現場安全管制影響。以下以官方公開資訊為基礎，重要行程仍請在出發前查看新北旅客最新公告。</p>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <article class="rounded-3xl border border-white/12 bg-white/7 p-7">
          <p class="text-sm font-bold text-[#9dd8c8]">開放時間</p>
          <h3 class="mt-3 font-serif text-2xl">季節性時段</h3>
          <div class="mt-5 space-y-4 text-white/76">
            <p><strong class="text-white">夏季（官方景點頁列示 6–9 月）</strong><br />09:00–18:00，最後入園 17:30</p>
            <p><strong class="text-white">非夏季（官方景點頁列示 10–5 月）</strong><br />09:00–17:00，最後入園 16:30</p>
          </div>
          <p class="mt-5 text-xs leading-6 text-white/50">部分年度另有春夏延長開園公告；以新北市政府觀光旅遊局當期公告優先。</p>
        </article>
        <article class="rounded-3xl border border-white/12 bg-white/7 p-7">
          <p class="text-sm font-bold text-[#9dd8c8]">門票 / 費用</p>
          <h3 class="mt-3 font-serif text-4xl">免費入園</h3>
          <p class="mt-5 text-white/72">新北旅客景點頁列示十分瀑布公園門票為免費。停車、餐飲或其他周邊服務若有費用，以各現場公告為準。</p>
          <a href="https://newtaipei.travel/zh-tw/Attractions/Detail/109612" target="_blank" rel="noopener external" class="mt-6 inline-block text-sm font-bold text-[#b6e8da] underline underline-offset-4">查看新北旅客官方景點頁 →</a>
        </article>
        <article class="rounded-3xl border border-white/12 bg-white/7 p-7">
          <p class="text-sm font-bold text-[#9dd8c8]">最佳時段 / 停留時間</p>
          <h3 class="mt-3 font-serif text-2xl">開園後前段，走得更從容</h3>
          <p class="mt-5 text-white/72">若希望避開較多團客，可優先選平日、開園後較早時段。單看瀑布與步道建議預留約 1.5–2.5 小時；若加上十分老街、車站與靜安吊橋，可安排半日。</p>
          <p class="mt-4 text-sm text-white/55">雨後水量可能較充沛，但步道濕滑與溪水風險也會上升；豪雨或颱風期間請依官方管制。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div><p class="section-kicker">實景照片</p><h2 class="section-title">從正面水幕到平溪鐵道，十分的四種視角</h2></div>
        <p class="max-w-xl text-sm leading-7 text-[#61756f]">網站使用的實景照片均放在專案 <code class="rounded bg-[#edf5f2] px-1.5 py-1">public/images</code> 內，不從外站熱連；來源與授權保留於圖說及專案授權檔。</p>
      </div>
      <div class="grid gap-5 md:grid-cols-12">
        <figure class="md:col-span-7"><img src="/images/shifen-waterfall-angle.jpg" alt="不同角度望向十分瀑布與瀑潭" width="1500" height="1125" loading="lazy" class="aspect-[4/3] w-full rounded-3xl object-cover" /><figcaption class="mt-2 text-xs text-[#71867f]">照片：Zairon · CC BY-SA 4.0</figcaption></figure>
        <figure class="md:col-span-5"><img src="/images/shifen-waterfall-portrait.jpg" alt="近距離觀看十分瀑布水流" width="1000" height="1250" loading="lazy" class="aspect-[4/5] w-full rounded-3xl object-cover" /><figcaption class="mt-2 text-xs text-[#71867f]">照片：Andrewhaimerl · CC BY 4.0</figcaption></figure>
        <figure class="md:col-span-12"><img src="/images/shifen-old-street-train.jpg" alt="平溪線列車行經十分一帶的山城鐵道景觀" width="1600" height="1067" loading="lazy" class="aspect-[16/7] w-full rounded-3xl object-cover object-center" /><figcaption class="mt-2 text-xs text-[#71867f]">平溪線鐵道實景。照片：Cassiopeia sweet · 公有領域</figcaption></figure>
      </div>
    </div>
  </section>

  <section id="transport" class="section mist-bg">
    <div class="container">
      <p class="section-kicker">詳細交通</p>
      <h2 class="section-title">詳細交通：把「十分車站」與「十分遊客中心」當作兩個入口理解</h2>
      <p class="section-copy">鐵路旅客多從十分車站與老街方向步行；公車與開車旅客則可把十分遊客中心作為清楚的轉折點，再走友善步道前往瀑布園區。</p>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="card p-7"><div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-[#e2f2ed] font-bold text-[#1c6657]">鐵</span><h3 class="font-serif text-2xl font-bold">臺鐵平溪線</h3></div><p class="mt-4 text-[#526861]">可先搭臺鐵至<strong>瑞芳站或猴硐站</strong>轉乘平溪線，在<strong>十分站</strong>下車。從十分車站可順遊老街、靜安吊橋，再沿指標往瀑布；步行時間依路線、人流與停留方式而異，建議預留約 20 分鐘以上。</p><p class="mt-4 text-sm text-[#71857f]">交通部觀光署亦將平溪線列為可由瑞芳或猴硐轉乘的鐵道旅遊路線。</p></article>
        <article class="card p-7"><div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-[#e2f2ed] font-bold text-[#1c6657]">巴</span><h3 class="font-serif text-2xl font-bold">公車 / 台灣好行</h3></div><p class="mt-4 text-[#526861]">新北市官方區域旅遊資訊列有：臺北捷運文湖線<strong>木柵站</strong>轉乘台灣好行木柵—平溪線（795），沿線經菁桐、平溪、十分老街並可到<strong>十分遊客中心（十分瀑布）</strong>；另可從瑞芳搭 846，或查詢新北市新巴士相關路線。</p><p class="mt-4 text-sm text-[#71857f]">班次、停靠與營運安排會調整，出發前請查官方即時資訊。</p></article>
        <article class="card p-7"><div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-[#e2f2ed] font-bold text-[#1c6657]">步</span><h3 class="font-serif text-2xl font-bold">十分友善步道</h3></div><p class="mt-4 text-[#526861]">由十分遊客中心前方進入，官方資料指出友善步道<strong>全長約 400 公尺、步行約 15 分鐘</strong>可抵園區入口，以平緩坡道取代部分階梯。新北市近年亦持續串接無障礙通道，讓輪椅、嬰兒車與高齡旅客更容易通行。</p><p class="mt-4 text-sm text-[#71857f]">山區仍可能因天候、施工或維修臨時調整通行。</p></article>
        <article class="card p-7"><div class="flex items-center gap-3"><span class="grid size-11 place-items-center rounded-full bg-[#e2f2ed] font-bold text-[#1c6657]">車</span><h3 class="font-serif text-2xl font-bold">開車與計程車</h3></div><p class="mt-4 text-[#526861]">導航可使用使用者提供的 Google 地圖位置，或以<strong>十分遊客中心：新北市平溪區南山里南山坪136號</strong>作為到達點，再按現場指標步行前往。山區道路較窄，假日車流增加時，大眾運輸通常更省去找車位的壓力。</p><a href="https://maps.app.goo.gl/tf7NwV2xuaYJ4ZiQ8" target="_blank" rel="noopener external" class="mt-4 inline-block text-sm font-bold text-[#1c6657] underline underline-offset-4">Google 地圖導航 →</a></article>
      </div>

      <div class="mt-8 rounded-[2rem] bg-[#071d1a] p-7 text-white lg:p-9">
        <div class="grid gap-7 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
          <div><p class="text-sm font-bold tracking-widest text-[#8ed1bf]">停車資訊</p><h3 class="mt-2 font-serif text-3xl">以十分遊客中心周邊導引為準</h3></div>
          <div class="text-white/72"><p>新北旅客的十分瀑布公園景點頁列有「停車場」服務設施。自駕建議依十分遊客中心與現場交通指示進場；停車位、收費與臨時管制可能因時段或活動而異，本指南不寫入容易過期的精確車位數與費率。</p><p class="mt-3 text-sm text-white/52">假日與大型活動期間建議優先搭乘臺鐵或公車；請勿違規停放於狹窄道路或影響居民出入。</p></div>
        </div>
      </div>
    </div>
  </section>

